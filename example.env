# Copy to .env.local (never commit .env.local).
# Nord affiliate portal → Tools → APIs (TUNE / HasOffers Affiliate API).

NORD_AFFILIATE_NETWORK_ID=nordvpn
NORD_AFFILIATE_API_KEY=

# Google Analytics 4 — enables affiliate_click events on CTA buttons
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Protects POST /api/indexnow when set (Bearer token). Optional; npm run indexnow uses CLI directly.
# INDEXNOW_SUBMIT_SECRET=

# Non-Nord affiliate tracking: replace plain URLs in lib/content/providers.ts
# AFFILIATE_URLS when you have Surfshark/Express/Proton/Pure program links.
